# Получите значения в Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sentry (опционально): без DSN SDK не отправляет события и не мешает dev/сборке
# Client DSN: Project → Settings → Client Keys
EXPO_PUBLIC_SENTRY_DSN=

# Для EAS Build / загрузки source maps (секрет в EAS, не в репозитории)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
