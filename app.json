{
  "expo": {
    "name": "FindIT",
    "slug": "findit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/LogoFinal.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/LogoFinal.png",
      "resizeMode": "contain",
      "backgroundColor": "#051630"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ironrock.findit",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "FindIT"
      }
    },
    "android": {
      "package": "com.ironrock.findit",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/LogoFinal.png",
        "backgroundColor": "#051630"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/LogoFinal.png"
    },
    "extra": {
      "eas": {
        "projectId": "5a0276b2-c124-4738-902f-813332482807"
      }
    },
    "owner": "iron-rock",
    "plugins": [
      "@sentry/react-native",
      "expo-video",
      "expo-font",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "FindIT нужен доступ к фото, чтобы отправлять изображения в чате."
        }
      ]
    ]
  }
}
